# Copy to .env and fill in. Each environment (production / qa / local) points
# at its own Firebase project — see docs/ENVIRONMENTS.md.
#
# For local development, use the QA project's values, not production's.
#
# Find these in Firebase Console > Project settings > General > Your apps >
# SDK setup and configuration.
#
# Note: the Firebase web config is not secret — it ships in the client bundle.
# Access is controlled by Firestore security rules, not by hiding these values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only needed if you want Analytics.
VITE_FIREBASE_MEASUREMENT_ID=

# production | qa | development
# Anything other than "production" shows a banner naming the environment,
# so nobody mistakes QA for the real thing.
VITE_APP_ENV=development
